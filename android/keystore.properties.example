# Copy to android/keystore.properties (gitignored) and fill in real values.
# Place the upload keystore next to this file as android/upload-keystore.jks.
# Keep a backup of the .jks plus passwords — Play needs this key for every update.
storeFile=upload-keystore.jks
storePassword=REPLACE_ME
keyAlias=upload
keyPassword=REPLACE_ME
